# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_NAME=emissor_nfce

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=1d

# Application
PORT=3000

# Bling Integration (OAuth 2.0)
# Obtenha Client ID e Secret em: https://www.bling.com.br (Preferências > Integrações > API)
BLING_CLIENT_ID=seu_client_id_aqui
BLING_CLIENT_SECRET=seu_client_secret_aqui
BLING_REDIRECT_URI=http://localhost:3000/api/bling/callback
BLING_API_BASE_URL=https://api.bling.com.br
BLING_API_URL=https://api.bling.com.br/Api/v3
BLING_AUTHORIZATION_URL=https://www.bling.com.br/Api/v3/oauth/authorize
BLING_TOKEN_URL=https://www.bling.com.br/Api/v3/oauth/token
TOKENS_FILE=./tokens.json
FRONTEND_URL=http://localhost:5173

# Em produção, use URLs com HTTPS:
# BLING_REDIRECT_URI=https://seudominio.com/api/bling/callback
# FRONTEND_URL=https://seuapp.com


# Somente para importar a integração global antiga quando houver vários usuários:
# LEGACY_BLING_USER_ID=uuid-do-usuario-proprietario

# Processar automaticamente os RPS pendentes de cada conta conectada
AUTO_RPS_ENABLED=true


# Credenciais de Acesso ao Painel (Env Auth)
AUTH_USER=admin@vilapet.com.br
AUTH_PASSWORD=VilaPet#Office!2026
AUTH_USER_NAME=Vila Pet Office
MCP_API_KEY=vilapet-hermes-mcp-key

# MCP financeiro. O endpoint fica desligado enquanto esses três campos não forem configurados.
OFFICE_FINANCE_MCP_KEY=
OFFICE_FINANCE_MCP_USER_ID=
OFFICE_FINANCE_MCP_ACCOUNT_IDS=

# Proteção contra força bruta no login (valores opcionais; defaults abaixo)
LOGIN_MAX_ATTEMPTS=5
LOGIN_ACCOUNT_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15
